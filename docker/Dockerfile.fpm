# ---- Stage 1: Composer dependencies ----
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

# Install PHP deps without running scripts yet (artisan isn't copied in until
# the next COPY, so any composer script that calls `php artisan ...` would fail here)
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction

COPY . .

RUN mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs

# Now generate the optimized autoloader and run discovery scripts with full app code present
RUN composer dump-autoload --optimize --no-dev \
    && composer run-script post-autoload-dump --no-dev

# ---- Stage 2: Runtime image ----
FROM php:8.4-fpm-trixie AS runtime

# Build the PHP extensions, then remove the compilers and -dev headers they
# needed. Only the shared libraries the extensions link against (libpq5,
# libzip4, ...) are kept, found by ldd rather than listed by hand. This is the
# pattern the official php image uses; it keeps build tooling and its CVEs out
# of the runtime image. git/unzip are gone too: composer runs only in the
# vendor stage.
RUN set -eux; \
    savedAptMark="$(apt-mark showmanual)"; \
    apt-get update; \
    apt-get install -y --no-install-recommends libpq-dev libzip-dev; \
    docker-php-ext-install -j"$(nproc)" pdo_pgsql pgsql bcmath opcache zip; \
    apt-mark auto '.*' > /dev/null; \
    [ -z "$savedAptMark" ] || apt-mark manual $savedAptMark; \
    find /usr/local -type f -executable -exec ldd '{}' ';' \
        | awk '/=>/ { so = $(NF-1); if (index(so, "/usr/local/") == 1) { next }; gsub("^/(usr/)?", "", so); printf "*%s\n", so }' \
        | sort -u | xargs -r dpkg-query --search | cut -d: -f1 | sort -u | xargs -r apt-mark manual; \
    apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false; \
    rm -rf /var/lib/apt/lists/*; \
    php -m | grep -E '^(pdo_pgsql|pgsql|bcmath|Zend OPcache|zip)$'

# Recommended production opcache settings
RUN { \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.interned_strings_buffer=8'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.enable_cli=0'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini

WORKDIR /var/www/html

COPY --from=vendor /app ./

# php-fpm listens on TCP (not the default unix socket) so the sibling nginx
# container in the same pod can reach it over the pod's loopback interface
RUN sed -i \
        -e 's|^listen = .*|listen = 9000|' \
        /usr/local/etc/php-fpm.d/www.conf

RUN chown -R 33:33 /var/www/html/storage /var/www/html/bootstrap/cache

# Numeric UID, not "www-data": with runAsNonRoot the kubelet can only prove a
# numeric user is non-root; a name makes the pod fail to start under the
# restricted Pod Security profile. 33 is www-data on Debian.
USER 33:33

EXPOSE 9000

CMD ["php-fpm"]
