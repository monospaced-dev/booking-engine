# nginx only serves static files from public/ and hands *.php to php-fpm
# over the pod's loopback, so it needs the public/ directory and nothing
# else (booking-engine ships no frontend build). No composer stage needed.
#
# nginx-unprivileged runs as UID 101, listens on 8080, and keeps its pid
# and temp files in /tmp, so it passes the restricted Pod Security profile.
# The stock nginx image starts as root and fails runAsNonRoot.
FROM nginxinc/nginx-unprivileged:1.30-alpine

COPY public /var/www/html/public
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
