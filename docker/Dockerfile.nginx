# Reuses the same vendor/app-code build stage as Dockerfile.fpm so the
# public/ directory (and anything it references) is always in sync with
# what php-fpm is running — no separate "npm run build" needed here since
# booking-engine ships no frontend assets.
FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY . .
RUN composer dump-autoload --optimize --no-dev

FROM nginx:1.27-alpine

COPY --from=vendor /app/public /var/www/html/public
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
